# ShareUSTC 容器部署环境变量模板
# 复制为 deploy/.env（已 gitignore，含密钥不入库），填好后执行 docker compose up -d --build。
# docker-compose.yml 通过 env_file 将本文件注入 postgres 与 backend 容器。

# ===== PostgreSQL（postgres 容器初始化用）=====
POSTGRES_DB=shareustc
POSTGRES_USER=shareustc_app
POSTGRES_PASSWORD=please_change_me

# ===== 后端数据库连接（主机名为 compose 服务名 postgres）=====
# 其中的用户名/密码/库名需与上面 POSTGRES_* 保持一致
DATABASE_URL=postgres://shareustc_app:please_change_me@postgres:5432/shareustc

# ===== JWT（必填，高强度随机；拒绝空串/占位值/长度<16）=====
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# ===== 图床外链（必填）=====
# 站点公开 origin（不含末尾 /images）；同域反代部署即站点地址
IMAGE_BASE_URL=https://shareustc.example.com

# ===== CORS =====
# 同域反代下前端与后端同源、请求不跨域，配为站点 origin 即可；禁止使用 *
CORS_ALLOWED_ORIGINS=https://shareustc.example.com

# ===== Cookie（经 HTTPS 对外时必须 true）=====
COOKIE_SECURE=true

# ===== 管理员用户名（逗号分隔）=====
ADMIN_USERNAMES=admin

# ===== 用户策略（均可选，缺省即下方默认值）=====
# 注册时是否强制要求邮箱（默认 false）
REGISTER_REQUIRE_EMAIL=false
# 是否允许用户修改用户名（默认 true）
ALLOW_USERNAME_CHANGE=true
# 是否允许用户修改邮箱（默认 true）
ALLOW_EMAIL_CHANGE=true

# ===== PDF 预览检测（可选）=====
# 留空则后端 /config 返回 enabled=false，前端「PDF 预览检测」入口不可用（检测页显示「尚未配置」、
# 设置页的自动加载开关保持禁用）。需要启用时，填入用作挑战的 PDF 资源 UUID（内容含四位数字）
# 与对应验证码。
PDF_PREVIEW_CHALLENGE_UUID=
PDF_PREVIEW_CHALLENGE_CODE=

# ===== 服务名 / 日志 =====
SERVICE_NAME=ShareUSTC Backend
RUST_LOG=backend=info,actix_web=info,sqlx=warn

# ===== 存储后端（默认 local；路线 B 切 oss 时取消注释并填写 OSS_*）=====
STORAGE_BACKEND=local
