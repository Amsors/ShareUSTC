# ShareUSTC 后端环境变量示例
# 复制为 .env 后按实际环境修改。标注【必填】的项缺失或为占位值时后端会拒绝启动。
#
# 容器部署：本文件仅供裸机/本机开发参考；compose 部署时通过 deploy/.env 与
# compose secrets 注入，详见 docs/deploy_guide.md「容器部署」章节。

# ============ 数据库（必填） ============
# 【必填】容器部署时主机名应为 compose 服务名（如 postgres），不能用 localhost
DATABASE_URL=postgres://shareustc_app:change_me@localhost:5432/shareustc

# ============ JWT（必填） ============
# 【必填】高强度随机字符串，长度不少于 16；拒绝空串与常见占位值。
# 生成示例：openssl rand -base64 48
# 注意：下面这个示例值本身在拒绝名单中，直接照抄会导致启动失败——请务必替换。
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 说明：Access/Refresh Token 的有效期当前由代码常量定义
# （backend/src/utils/jwt.rs 的 ACCESS_TOKEN_EXPIRE_MINUTES / REFRESH_TOKEN_EXPIRE_DAYS），
# 不再通过环境变量配置（旧的 JWT_EXPIRATION / JWT_REFRESH_EXPIRATION 从未被解析，已移除）。

# ============ 服务监听 ============
# 缺省即 0.0.0.0（容器/生产），本机开发可显式设为 127.0.0.1 仅本地访问
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 服务名称，用于健康检查接口和日志显示；迁移到其他学校部署可改为自己的名称
SERVICE_NAME="ShareUSTC Backend"

# ============ 图床外链（必填） ============
# 【必填】图床功能依赖，用于生成图片/Markdown 引用的公开访问链接前缀。
# 同域反代部署时设为站点公开 origin（不含末尾 /images），例如：
#   IMAGE_BASE_URL=https://shareustc.example.com
# 生成的图片链接形如 {IMAGE_BASE_URL}/images/{id}
IMAGE_BASE_URL=http://localhost:8080

# ============ CORS ============
# 允许访问的域名列表，多个用逗号分隔。
# 同域反代部署下前端与后端同源、请求不跨域，配为站点实际 origin 即可。
# 生产环境禁止使用 *（放行任意来源），仅本机联调可临时使用。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 文件上传 ============
# 上传根路径；images/、resources/ 子目录由代码派生（不再单独配置子路径变量）。
# 容器内固定为绝对路径 /data/uploads 并挂载 named volume；本机开发保持 ./uploads。
# 说明：单个资源最大 100MB、单张图片最大 5MB，由代码常量定义
# （backend/src/services/file_service.rs 的 MAX_FILE_SIZE、image_service.rs 的 5MB），
# 支持的资源类型由 ResourceType 枚举定义（旧的 MAX_FILE_SIZE / ALLOWED_FILE_TYPES
# 环境变量从未被解析，已移除）。若使用 nginx 反代，其 client_max_body_size 需与上限保持一致。
FILE_UPLOAD_PATH=./uploads

# ============ 存储后端 ============
# local: 本地文件系统（默认）
# oss: 阿里云 OSS（已支持读写、签名下载、STS 直传回调）
STORAGE_BACKEND=local

# OSS 配置（仅 STORAGE_BACKEND=oss 时需要；生产密钥请经部署环境/ secrets 注入，勿写入镜像）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_STS_ROLE_ARN=
OSS_STS_SESSION_DURATION=900
OSS_KEY_PREFIX=
OSS_SIGNED_URL_EXPIRY=600

# ============ 日志 ============
# 格式: 模块名=级别 (trace, debug, info, warn, error)；生产建议 info 或 warn。
# 未设置时使用默认过滤器 backend=debug,actix_web=info,sqlx=warn。
RUST_LOG=backend=info,actix_web=info,sqlx=warn

# ============ 管理员 ============
# 管理员用户名列表，多个用逗号分隔。列表中的用户注册时自动获得管理员权限；
# 后端启动时会同步：列表内用户赋予管理员、不在列表内的管理员被取消权限。
ADMIN_USERNAMES=admin

# ============ Cookie 安全 ============
# true 时 Cookie 仅通过 HTTPS 传输；生产（HTTPS）必须为 true，开发为 false。
COOKIE_SECURE=false

# ============ 用户策略 ============
# 注册时是否强制要求邮箱，默认 false
REGISTER_REQUIRE_EMAIL=false
# 是否允许用户修改用户名/邮箱，默认 true
ALLOW_USERNAME_CHANGE=true
ALLOW_EMAIL_CHANGE=true

# ============ PDF 预览检测 ============
# 检测浏览器是否支持 PDF 预览的挑战资源 UUID（应为含四位数字的 PDF）与对应验证码
PDF_PREVIEW_CHALLENGE_UUID=
PDF_PREVIEW_CHALLENGE_CODE=
