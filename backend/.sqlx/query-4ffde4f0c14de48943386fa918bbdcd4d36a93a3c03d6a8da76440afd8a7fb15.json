{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                c.id,\n                c.resource_id,\n                c.user_id,\n                c.content,\n                c.created_at,\n                u.username as user_name\n            FROM comments c\n            JOIN users u ON c.user_id = u.id\n            WHERE c.resource_id = $1 AND c.audit_status = 'approved'\n            ORDER BY c.created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
